# Copy to .env.local and fill in your own Atlas connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0"
MONGODB_DB="dsa_tracker"

# Signs session cookies for accounts (HMAC-SHA256). Generate a random one,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Rotating this signs everyone out.
AUTH_SECRET="<random-hex-string>"
